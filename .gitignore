# com cache vazio; o antigo continua servindo à retomada/reprodução da sua).
cache-*/
# Logs de execução local da bateria (a trilha oficial fica no manifesto).
*.log
.env
.env.*

# O held-out NUNCA entra neste repositório (defesa em profundidade;
# ele é gravado em ~/Dev/bncc-benchmark-heldout/, fora daqui)
*heldout*
*held-out*

# exceção: o template de exemplo é público
!.env.example

# Documentos internos (estratégia de abertura, manual de triagem da comunidade,
