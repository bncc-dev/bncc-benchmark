# Copie para .env e preencha só as chaves dos provedores que for usar.
# O harness carrega este arquivo da raiz (harness/lib/env.ts); o .env vence
# variáveis exportadas na shell. Nunca commite o .env.

# Rotas diretas (leaderboard desde a D15 e estudo de intervenção, D14.1)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
META_API_KEY=
DEEPSEEK_API_KEY=
MARITACA_API_KEY=
# Alibaba (DashScope): entradas `-direto` do Qwen; a conta precisa ter os
# modelos liberados no console do Model Studio, senão a API responde 403.
DASHSCOPE_API_KEY=

# OpenRouter: Qwen e DeepSeek no leaderboard (sem rota direta viável hoje)
OPENROUTER_API_KEY=

# AWS Bedrock: sonnet-4.6, haiku-4.5 e o juiz haiku-bedrock
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Seed do conjunto held-out (só mantenedores). Necessária apenas para
# `pnpm gerar --com-heldout`; o `pnpm gerar` normal não usa esta variável.
# O gerador é determinístico, então esta seed É o held-out: nunca a versione,
# nunca a compartilhe fora do time. Ver DECISOES.md D5 e SECURITY.md.
SEED_HELDOUT=
