# Copie para .env e preencha só as chaves dos provedores que for usar.
# O harness carrega este arquivo da raiz (harness/lib/env.ts); nunca commite o .env.

# Anthropic direto (opcional; o elenco oficial usa Bedrock/OpenRouter)
ANTHROPIC_API_KEY=

# OpenRouter (OpenAI, Anthropic, Google, xAI, Moonshot, Alibaba...)
OPENROUTER_API_KEY=

# AWS Bedrock (sonnet/haiku via Bedrock e o juiz haiku-bedrock)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Provedores diretos
DEEPSEEK_API_KEY=
MARITACA_API_KEY=

# Seed do conjunto held-out (só mantenedores). Necessária apenas para
# `pnpm gerar --com-heldout`; o `pnpm gerar` normal não usa esta variável.
# O gerador é determinístico, então esta seed É o held-out: nunca a versione,
# nunca a compartilhe fora do time. Ver DECISOES.md D5 e SECURITY.md.
SEED_HELDOUT=
